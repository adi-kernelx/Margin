# Optional settings for the local services. All have working defaults.
# The services read these from the process environment (no .env loader).

# RAG API (local-llm/rag-api), port 9101
LLM_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server; default is Ollama
LLM_MODEL=qwen2.5:3b-instruct
LLM_MAX_TOKENS=512
LLM_TIMEOUT=300
LLM_NUM_CTX=8192                         # context window sent to Ollama
LLM_API=ollama                           # ollama (native, reports token speeds) | openai
QDRANT_URL=                              # empty = embedded Qdrant at QDRANT_PATH
QDRANT_PATH=local-llm/data/qdrant
QDRANT_API_KEY=
RETRIEVAL=hybrid_concepts                # dense | hybrid | hybrid_concepts | hybrid_concepts_links
RERANK=cross_encoder                     # cross_encoder | ranker (opt-in)
RANKER_PATH=ml/models/artifacts/ranker.joblib
VERIFIED_BOOST=1.0
MARGIN_ML_ROOT=.                         # folder that contains ml/

# OCR service (ocr-service), port 8000
OCR_ENGINE=paddleocr
OCR_MODEL_DIR=/models
