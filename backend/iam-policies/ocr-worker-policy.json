{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadPageImages",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:HeadObject"
            ],
            "Resource": [
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/pages/*"
            ]
        },
        {
            "Sid": "WriteOCRSidecarsAndManifest",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:HeadObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/ocr/*",
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/manifest.json"
            ]
        },
        {
            "Sid": "S3CopyForAtomicWrite",
            "Effect": "Allow",
            "Action": [
                "s3:CopyObject"
            ],
            "Resource": [
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/ocr/*"
            ]
        },
        {
            "Sid": "SQSConsume",
            "Effect": "Allow",
            "Action": [
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:GetQueueAttributes",
                "sqs:ChangeMessageVisibility"
            ],
            "Resource": [
                "arn:aws:sqs:ap-south-1:515823085623:ocr-page-ingest"
            ]
        },
        {
            "Sid": "SecretsReadForWorker",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Resource": [
                "arn:aws:secretsmanager:ap-south-1:515823085623:secret:gc-vision-sa-*"
            ]
        },
        {
            "Sid": "CloudWatchLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": [
                "arn:aws:logs:ap-south-1:515823085623:log-group:/aws/lambda/ocr-page-worker:*"
            ]
        },
        {
            "Sid": "EventBridgeOptional",
            "Effect": "Allow",
            "Action": [
                "events:PutEvents"
            ],
            "Resource": [
                "arn:aws:events:ap-south-1:515823085623:event-bus/default"
            ]
        }
    ]
}