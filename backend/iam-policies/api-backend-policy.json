{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3PresignAndManifestAccess",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:HeadObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/pages/*",
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/original.pdf",
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/manifest.json",
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/docs/*/annotations/*",
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/files/*",
                "arn:aws:s3:::pdf-reader-uploads-aditya/users/*/folders/*"
            ]
        },
        {
            "Sid": "S3ListForCleanup",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::pdf-reader-uploads-aditya",
            "Condition": {
                "StringLike": {
                    "s3:prefix": "users/*"
                }
            }
        },
        {
            "Sid": "SQSEnqueue",
            "Effect": "Allow",
            "Action": [
                "sqs:SendMessage",
                "sqs:GetQueueUrl"
            ],
            "Resource": [
                "arn:aws:sqs:ap-south-1:515823085623:ocr-page-ingest"
            ]
        },
        {
            "Sid": "SecretsReadForBackend",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Resource": [
                "arn:aws:secretsmanager:ap-south-1:515823085623:secret:gc-vision-sa-*"
            ]
        }
    ]
}