# ==================================================
# Margin - .gitignore
# ==================================================

# -------------------
# Dependencies
# -------------------
node_modules/
.pnp
.pnp.js

# -------------------
# Build outputs
# -------------------
dist/
dist-demo/
dist-ssr/
build/
*.local
.vite/
*.tsbuildinfo
.eslintcache

# -------------------
# Logs & temporary files
# -------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak

# -------------------
# Editors & OS
# -------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sw?
*.suo
*.sln
.DS_Store
Thumbs.db
desktop.ini

# -------------------
# Environment & secrets
# -------------------
.env
.env.*
!.env.example
!.env.demo
.runtimeconfig.json
*.pem
*.key
*.p12
*.pfx
service-account*.json
firebase-admin*.json
*-key.json
credentials*.json

# -------------------
# Python
# -------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
venv/
.venv/
.venv-*/
env/
pip-wheel-metadata/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# -------------------
# Testing & coverage
# -------------------
coverage/
.nyc_output/
*.lcov

# -------------------
# Local service data (Qdrant, caches, models)
# -------------------
data/
docker-data/
*.db
*.gguf
*.bin
*.safetensors
*.onnx
ocr-service/.paddleocr/
ocr-service/logs/
# ML pipeline source lives in ml/data/; the "data/" rule above must not hide it
!ml/data/

# -------------------
# PDFs (copyrighted); only the manifest and demo assets are tracked
# -------------------
*.pdf
!public/*.pdf
!src/demo/assets/*.pdf

# -------------------
# ML outputs with copyrighted text or learned vocabularies
# -------------------
ml/out/
ml/labels/*.jsonl
ml/labels/second_annotator/
ml/models/artifacts/
# Questions quote private/copyrighted PDFs
ml/eval/questions.jsonl
ml/eval/questions_independent.jsonl

# -------------------
# Local-only project notes
# -------------------
PROJECT_SUMMARY.md
docs/MARGIN_BUILD_PLAN.html
docs/FRONTEND_PLAN.md
docs/frontend_implementation_log.md
docs/CONTEXT_COMPRESSION_RESEARCH.md
docs/ML6_ROUTING.md

# -------------------
# AI assistant files and folders
# -------------------
.claude/
CLAUDE.md
.codex/
