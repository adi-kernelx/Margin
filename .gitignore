# ==================================================
# AI PDF Reader - Complete .gitignore
# ==================================================

# -------------------
# Logs & Debug Files
# -------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
build_log.txt
error.log
audit*.log

# -------------------
# Dependencies
# -------------------
node_modules/
.pnp
.pnp.js
package-lock.json.bak

# -------------------
# Build Outputs
# -------------------
dist/
dist-ssr/
build/
*.local
.vite/

# -------------------
# Editor & IDE
# -------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -------------------
# Environment & Secrets
# -------------------
.env
.env.*
!.env.example
.runtimeconfig.json

# Sensitive Keys & Credentials
*.pem
*.key
*.p12
*.pfx
service-account.json
vision-key.json
firebase-admin.json
*-key.json
credentials.json

# -------------------
# Backend Specific
# -------------------
backend/node_modules/
backend/dist/
backend/.env
backend/.env.*
!backend/.env.example
backend/firebase-admin.json
backend/qdrant_storage/
backend/typesense_data/
backend/audit.log
backend/audit-error.log
backend/scripts/
backend_backup_safe/

# -------------------
# Python Artifacts
# -------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
*.egg
venv/
.venv/
env/
.env/
pip-wheel-metadata/
*.whl

# -------------------
# Lambda & Deployment
# -------------------
*.zip
backend/lambda/*/package/
*.terraform
.terraform/

# -------------------
# RAG & ML Models
# -------------------
local-llm/models/
local-llm/rag-service/
rag-service/
*.gguf
*.bin
*.safetensors
*.onnx

# Embedding Cache
embedding_cache.db
*.db

# -------------------
# Ingest Sidecars
# -------------------
ingest-sidecars/sidecars/*.json
ingest-sidecars/embedding_cache.db

# -------------------
# OCR Service
# -------------------
ocr-service/.paddleocr/
ocr-service/logs/

# -------------------
# Docker Volumes
# -------------------
docker-data/
data/

# -------------------
# Agent & Temporary
# -------------------
.agent/
.gemini/
.agents/
.claude/
.codex/
.gpt/
.chatgpt/
CLAUDE.md
HANDOFF.md
GPT.md
CHATGPT.md
*.tmp
*.temp

# -------------------
# Internal Docs (Project-specific)
# -------------------
IMPLEMENTATION_PROGRESS.md
POINT_ERASER_ALGORITHM.md
ERASER_ENHANCEMENT.md

# -------------------
# Test PDFs & Samples
# -------------------
*.pdf
!docs/*.pdf
!public/*.pdf

# -------------------
# Firebase
# -------------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log

# -------------------
# Functions (Firebase)
# -------------------
functions/node_modules/
functions/lib/

# -------------------
# Coverage & Testing
# -------------------
coverage/
.nyc_output/
*.lcov
